# Copy to .env.local (gitignored) and set the same two variables in Vercel.
# The publishable key is public by design; the table itself is RLS-locked and only
# reachable through the capped public.search_claims function.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
